{
  "name": "fintrack-pro",
  "version": "1.0.0",
  "description": "Aplikasi Pencatatan Keuangan Pribadi & Arus Kas Lengkap",
  "main": "electron-main.js",
  "scripts": {
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win portable --x64",
    "android:init": "npx cap init \"FinTrack Pro\" com.fintrack.app --web-dir .",
    "android:add": "npx cap add android",
    "android:open": "npx cap open android"
  },
  "author": "FinTrack",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fintrack.pro",
    "productName": "FinTrack Pro",
    "win": {
      "target": ["portable", "nsis"],
      "icon": "icon-512.png"
    }
  }
}
